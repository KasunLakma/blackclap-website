---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Photo from "../../components/Photo.astro";
import { home } from "../../data/home.js";
import { allTheatre, featuredPlay } from "../../data/content.js";

const years = [...new Set(allTheatre.map((p) => p.year))];

const wins = (featuredPlay?.awards || []).filter((a) => a.type === "win");
const winText = wins.length
    ? `${wins.map((w) => w.title).join(" · ")} — ${wins[0].festival} ${wins[0].year}`
    : "";
---

<BaseLayout
    title="Productions | BLACKCLAP Film & Theatre Productions"
    description="Stage productions by BLACKCLAP, including physical theatre, monodramas and Sinhala stage dramas."
>
    <PageHero
        eyebrow="Productions"
        title="Our Theatre"
        text="Stage productions by BLACKCLAP, from our first monodrama in 2021 to our latest physical theatre work."
    />

    {featuredPlay && (
        <section class="featured">
            <Photo
                src={home.featured.image}
                position={home.featured.position}
                alt={featuredPlay.title}
                shade="linear-gradient(90deg, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.45) 55%, transparent 100%)"
            />
            <div class="container inner">
                <span class="eyebrow">Featured Production</span>
                <h2>{featuredPlay.title}</h2>
                <p class="tag">{featuredPlay.tagline}</p>
                {winText && <p class="note">{winText}</p>}
                <a href={`/theatre/${featuredPlay.slug}`} class="btn">
                    View Production <span>→</span>
                </a>
            </div>
        </section>
    )}

    <section class="section">
        <div class="container">
            {years.map((year) => (
                <div class="year-group">
                    <h2 class="year">{year}</h2>
                    <div class="grid">
                        {allTheatre
                            .filter((p) => p.year === year)
                            .map((play) => (
                                <ProjectCard item={play} base="/theatre" />
                            ))}
                    </div>
                </div>
            ))}
        </div>
    </section>
</BaseLayout>

<style>
    .featured {
        position: relative;
        min-height: 400px;
        display: flex;
        align-items: center;
        background: #000;
        border-bottom: 1px solid var(--line);
    }

    .inner {
        position: relative;
        z-index: 3;
        padding-top: 60px;
        padding-bottom: 60px;
    }

    .featured h2 {
        font-family: var(--font-serif);
        font-size: clamp(3rem, 8vw, 5.5rem);
        color: var(--yellow);
        line-height: 1;
    }

    .tag {
        font-size: 1.5rem;
        margin: 8px 0;
    }

    .note {
        color: #d0d0d0;
        max-width: 560px;
        margin-bottom: 24px;
        font-size: 0.98rem;
    }

    .year-group {
        margin-bottom: 60px;
    }

    .year {
        font-family: var(--font-display);
        font-size: 3rem;
        color: var(--yellow);
        line-height: 1;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .year::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--line);
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 22px;
    }
</style>
