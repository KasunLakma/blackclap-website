---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { allFilms, featuredFilm } from '../../data/content.js';

const years = [...new Set(allFilms.map((f) => f.year))];
---

<BaseLayout
  title="Film & Creative Works | BLACKCLAP"
  description="Short films produced by BLACKCLAP, including award-winning festival selections."
>
  <PageHero
    eyebrow="Film & Creative"
    title="Our Films"
    text="Short films produced by BLACKCLAP, from our first productions in 2020 to our latest festival selections."
  />

  {featuredFilm && (
    <section class="featured">
      <div class="container inner">
        <div class="text">
          <span class="eyebrow">Featured Film</span>
          <h2>{featuredFilm.title}</h2>
          <p class="tag">{featuredFilm.tagline}</p>
          <p class="note">Best Short Film · Best Director · Best Screenwriter — Onscreen 25 Short Film Festival 2025</p>
          <a href={`/films/${featuredFilm.slug}`} class="btn">View Film <span>→</span></a>
        </div>

        {featuredFilm.poster && (
          <a href={`/films/${featuredFilm.slug}`} class="fposter">
            <img src={featuredFilm.poster} alt={`${featuredFilm.title} poster`} />
          </a>
        )}
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      {years.map((year) => (
        <div class="year-group">
          <h2 class="year">{year}</h2>
          <div class="grid">
            {allFilms
              .filter((f) => f.year === year)
              .map((film) => (
                <ProjectCard item={film} base="/films" />
              ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .featured {
    background:
      radial-gradient(circle at 85% 40%, rgba(255, 212, 0, 0.14), transparent 55%),
      #000;
    border-bottom: 1px solid var(--line);
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 50px;
    padding-top: 60px;
    padding-bottom: 60px;
  }

  .featured h2 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 5.5rem);
    color: var(--yellow);
    line-height: 0.95;
  }

  .tag {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    margin: 8px 0;
  }

  .note {
    color: #d0d0d0;
    max-width: 560px;
    margin-bottom: 24px;
    font-size: 0.98rem;
  }

  .fposter {
    display: block;
    border: 1px solid var(--yellow);
    box-shadow: 0 0 60px rgba(255, 212, 0, 0.15);
    transition: transform 0.3s ease;
  }

  .fposter:hover {
    transform: translateY(-6px);
  }

  .fposter img {
    display: block;
    height: min(420px, 60vw);
    width: auto;
  }

  .year-group {
    margin-bottom: 60px;
  }

  .year {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--yellow);
    line-height: 1;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .year::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 22px;
  }

  @media (max-width: 800px) {
    .inner {
      grid-template-columns: 1fr;
    }

    .fposter {
      justify-self: start;
    }
  }
</style>
