---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import news from '../../data/news.json';
---

<BaseLayout
  title="News & Updates | BLACKCLAP Film & Theatre Productions"
  description="Latest news, awards and updates from BLACKCLAP Film & Theatre Productions."
>
  <PageHero
    eyebrow="News & Updates"
    title="Latest News"
    text="Awards, festival selections and updates from BLACKCLAP."
  />

  <section class="section">
    <div class="container">
      {news.length === 0 && <p class="empty">News and updates will be added here soon.</p>}

      <div class="grid">
        {news.map((n) => (
          <a href={`/news/${n.slug}`} class="post">
            <div class="thumb">
              {n.image ? <img src={n.image} alt={n.title} loading="lazy" /> : <span>{n.category}</span>}
            </div>
            <div class="body">
              <p class="meta">{n.category} · {n.date}</p>
              <h2>{n.title}</h2>
              <p class="sum">{n.summary}</p>
              <span class="more">Read more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .empty {
    color: var(--muted);
    font-size: 1.2rem;
    text-align: center;
    padding: 60px 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
  }

  .post {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    background: #080808;
    transition: all 0.3s ease;
  }

  .post:hover {
    border-color: var(--yellow);
    transform: translateY(-5px);
  }

  .thumb {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 70% 30%, rgba(255, 212, 0, 0.25), transparent 60%),
      #0a0a0a;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumb span {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--yellow);
  }

  .body {
    padding: 22px 22px 26px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .meta {
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 2px;
    font-size: 0.78rem;
    color: var(--yellow);
  }

  h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1.05;
    color: #fff;
    margin: 8px 0 10px;
  }

  .sum {
    color: var(--muted);
    font-size: 0.98rem;
    flex: 1;
  }

  .more {
    margin-top: 16px;
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-size: 0.82rem;
    color: var(--yellow);
  }
</style>
