---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutSection from '../components/AboutSection.astro';
import FeaturedProduction from '../components/FeaturedProduction.astro';
import TileGrid from '../components/TileGrid.astro';
---

<BaseLayout title="BLACKCLAP Film & Theatre Productions | Stage • Film • Beyond">
  <section class="hero">
    <div class="hero-media">
      <img src="/images/the-swing-02.jpg" alt="The Swing – a BLACKCLAP theatre production" />
    </div>

    <div class="container hero-inner">
      <p class="kicker">Stage <i>•</i> Film <i>•</i> Beyond</p>

      <h1>BLACKCLAP</h1>
      <h2>Film &amp; Theatre Productions</h2>

      <span class="rule"></span>

      <p class="tagline">
        Stories that move.<br />
        Performances that live.
      </p>

      <a href="/about" class="btn">Explore Our Journey <span>→</span></a>
    </div>
  </section>

  <AboutSection />
  <FeaturedProduction />
  <TileGrid />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 90px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #000;
  }

  .hero-media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(60vw, 860px);
    -webkit-mask-image: linear-gradient(to left, #000 60%, transparent 100%);
    mask-image: linear-gradient(to left, #000 60%, transparent 100%);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 50%;
    transform: scaleX(-1);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
  }

  .kicker {
    font-family: var(--font-label);
    letter-spacing: 8px;
    text-transform: uppercase;
    font-size: 0.95rem;
    margin-bottom: 14px;
  }

  .kicker i {
    font-style: normal;
    margin: 0 10px;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 13vw, 9.5rem);
    color: var(--yellow);
    line-height: 0.9;
  }

  h2 {
    font-family: var(--font-label);
    font-weight: 400;
    color: var(--yellow);
    letter-spacing: clamp(3px, 0.9vw, 9px);
    text-transform: uppercase;
    font-size: clamp(1.1rem, 2.8vw, 2.1rem);
    margin-top: 6px;
  }

  .rule {
    display: block;
    width: 80px;
    height: 3px;
    background: var(--yellow);
    margin: 28px 0;
  }

  .tagline {
    font-size: 1.5rem;
    line-height: 1.4;
    margin-bottom: 32px;
  }

  /* Phone: ඡායාරූපය උඩින් (සම්පූර්ණ දීප්තියෙන්), අකුරු යටින් */
  @media (max-width: 800px) {
    .hero {
      display: block;
      min-height: auto;
    }

    .hero-media {
      position: relative;
      top: auto;
      right: auto;
      bottom: auto;
      width: 100%;
      height: min(105vw, 560px);
      -webkit-mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 62%, transparent 100%);
    }

    .hero-media img {
      object-position: center 38%;
    }

    .hero-inner {
      margin-top: -64px;
      padding-bottom: 56px;
    }

    .kicker {
      letter-spacing: 5px;
      font-size: 0.8rem;
    }

    h2 {
      font-size: 0.98rem;
      letter-spacing: 2.5px;
    }

    .rule {
      margin: 22px 0;
    }

    .tagline {
      font-size: 1.3rem;
    }
  }
</style>
