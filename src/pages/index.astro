---
import BaseLayout from "../layouts/BaseLayout.astro";
import AboutSection from "../components/AboutSection.astro";
import FeaturedProduction from "../components/FeaturedProduction.astro";
import TileGrid from "../components/TileGrid.astro";
---

<BaseLayout title="BLACKCLAP Theatre Productions | Stage • Film • Beyond">
  <section class="hero">
    <div class="hero-media">
      <img
        src="/images/the-swing-02.jpg"
        alt="The Swing – a BLACKCLAP theatre production"
      />
    </div>

    <div class="container hero-inner">
      <p class="kicker">
        Stage <i>•</i> Film <i>•</i> Beyond
      </p>

      <h1>BLACKCLAP</h1>
      <h2>Theatre Productions</h2>

      <span class="rule"></span>

      <p class="tagline">
        Stories that move.
        <br />
        Performances that live.
      </p>

      <a href="/about" class="btn">
        Explore Our Journey <span>→</span>
      </a>
    </div>
  </section>
  <AboutSection />
  <FeaturedProduction />
  <TileGrid />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 90px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #000;
  }

  .sun {
    position: absolute;
    right: 8%;
    top: 50%;
    transform: translateY(-50%);
    width: min(48vw, 560px);
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(
        circle at 30% 30%,
        rgba(0, 0, 0, 0.25) 0 2%,
        transparent 3%
      ),
      radial-gradient(
        circle at 70% 60%,
        rgba(0, 0, 0, 0.2) 0 1.5%,
        transparent 2.5%
      ),
      var(--yellow);
    box-shadow: 0 0 120px rgba(255, 212, 0, 0.25);
  }
  .hero-media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(60vw, 860px);
    -webkit-mask-image: linear-gradient(to left, #000 60%, transparent 100%);
    mask-image: linear-gradient(to left, #000 60%, transparent 100%);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 65%;
    transform: scaleX(-1);
  }

  @media (max-width: 800px) {
    .hero-media {
      width: 100%;
      opacity: 0.35;
    }
  }
  .hero-inner {
    position: relative;
    z-index: 2;
  }

  .kicker {
    font-family: var(--font-label);
    letter-spacing: 8px;
    text-transform: uppercase;
    font-size: 0.95rem;
    margin-bottom: 14px;
  }

  .kicker i {
    font-style: normal;
    margin: 0 10px;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 13vw, 9.5rem);
    color: var(--yellow);
    line-height: 0.9;
  }

  h2 {
    font-family: var(--font-label);
    font-weight: 400;
    color: var(--yellow);
    letter-spacing: clamp(4px, 1.2vw, 12px);
    text-transform: uppercase;
    font-size: clamp(1.2rem, 3.4vw, 2.6rem);
    margin-top: 6px;
  }

  .rule {
    display: block;
    width: 80px;
    height: 3px;
    background: var(--yellow);
    margin: 28px 0;
  }

  .tagline {
    font-size: 1.5rem;
    line-height: 1.4;
    margin-bottom: 32px;
  }

  @media (max-width: 800px) {
    .sun {
      right: -20%;
      opacity: 0.35;
    }
  }
</style>
