---
import Photo from './Photo.astro';
import { home } from '../data/home.js';

const about = home.about;
---

<section class="about">
  <div class="media">
    <Photo
      src={about.image}
      alt="BLACKCLAP stage performance"
      shade="linear-gradient(90deg, transparent 60%, #000 100%)"
    />
  </div>

  <div class="content">
    <span class="eyebrow">About Us</span>
    <h2 class="title-serif" set:html={about.heading} />
    <p>{about.text}</p>
    <p class="motto">{about.motto}</p>
  </div>

  <div class="ring-wrap">
    <svg viewBox="0 0 200 200" class="ring" aria-hidden="true">
      <defs>
        <path
          id="ringPath"
          d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"
        ></path>
      </defs>
      <text class="ring-text">
        <textPath href="#ringPath" textLength="485" lengthAdjust="spacing">
          BLACKCLAP • THEATRE PRODUCTIONS •
        </textPath>
      </text>
    </svg>
    <span class="ring-center">BC</span>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1.1fr auto;
    align-items: center;
    gap: 0;
    background: #000;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .media {
    position: relative;
    min-height: 280px;
    height: 100%;
  }

  .content {
    padding: 48px 40px;
  }

  .content p {
    color: #e6e6e6;
    max-width: 560px;
    margin-top: 14px;
  }

  .content .motto {
    color: var(--yellow);
    font-weight: 600;
  }

  .ring-wrap {
    position: relative;
    width: 220px;
    height: 220px;
    margin: 0 60px 0 10px;
  }

  .ring {
    width: 100%;
    height: 100%;
    animation: spin 28s linear infinite;
  }

  .ring-text {
    font-family: var(--font-label);
    font-weight: 500;
    font-size: 15px;
    fill: var(--yellow);
  }

  .ring-center {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 4.2rem;
    color: var(--yellow);
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 1000px) {
    .about {
      grid-template-columns: 1fr;
    }

    .media {
      min-height: 240px;
    }

    .content {
      padding: 36px 28px;
    }

    .ring-wrap {
      margin: 0 auto 40px;
    }
  }
</style>