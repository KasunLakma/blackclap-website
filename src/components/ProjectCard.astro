---
import Photo from './Photo.astro';

const { item, base } = Astro.props;
const wins = (item.awards || []).filter((a) => a.type === 'win').length;
---

<a href={`${base}/${item.slug}`} class="card">
  <div class="poster">
    <Photo src={item.poster} alt={`${item.title} poster`} fit="contain" />
    {!item.poster && <span class="ph">{item.title}</span>}
  </div>

  <div class="info">
    <p class="meta">
      <span>{item.year}</span>
      {wins > 0 && <span class="wins">★ {wins} {wins === 1 ? 'Award' : 'Awards'}</span>}
    </p>
    <h3>{item.title}</h3>
    <p class="cat">{item.category}</p>
  </div>
</a>

<style>
  .card {
    display: block;
    border: 1px solid var(--line);
    background: #080808;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .card:hover {
    transform: translateY(-6px);
    border-color: var(--yellow);
  }

  .poster {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .ph {
    position: absolute;
    z-index: 3;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 20px;
    font-family: var(--font-display);
    font-size: 2.2rem;
    color: var(--yellow);
    line-height: 1;
  }

  .info {
    padding: 14px 18px 20px;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-size: 0.78rem;
    color: var(--yellow);
  }

  .wins {
    border: 1px solid var(--yellow);
    padding: 1px 8px;
  }

  h3 {
    font-family: var(--font-display);
    font-size: 1.7rem;
    line-height: 1;
    color: #fff;
    margin-top: 8px;
  }

  .card:hover h3 {
    color: var(--yellow);
  }

  .cat {
    margin-top: 6px;
    font-size: 0.9rem;
    color: var(--muted);
  }
</style>
