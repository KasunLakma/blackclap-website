---
const { eyebrow = '', title, text = '' } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {text && <p>{text}</p>}
  </div>
</section>

<style>
  .page-hero {
    padding: 90px 0 60px;
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 85% 20%, rgba(255, 212, 0, 0.14), transparent 55%),
      #000;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 9vw, 6.5rem);
    color: var(--yellow);
    line-height: 0.95;
  }

  p {
    max-width: 640px;
    margin-top: 18px;
    color: #d8d8d8;
    font-size: 1.15rem;
  }
</style>
