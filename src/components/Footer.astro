---
import { Icon } from 'astro-icon/components';
import { site } from '../data/site.js';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-band">
    <a href="/" class="brand-block">
      <span class="b-main">{site.name}</span>
      <span class="b-sub">{site.subtitle}</span>
    </a>

    <p class="motto">Create <i>•</i> Perform <i>•</i> Inspire</p>

    <form class="newsletter" action="#">
      <label for="email">Join Our Creative Journey</label>
      <div class="field">
        <input id="email" type="email" placeholder="Your Email Address" required />
        <button type="submit" aria-label="Subscribe">→</button>
      </div>
    </form>
  </div>

  <div class="footer-bottom">
    <div class="container bottom-inner">
      <p>© {year} {site.fullName}. All Rights Reserved.</p>
      <div class="socials">
        {site.socials.map((s) => (
          <a href={s.href} aria-label={s.name} target="_blank" rel="noopener">
            <Icon name={s.icon} size={20} />
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #000;
    border-top: 1px solid var(--line);
  }

  .footer-band {
    display: grid;
    grid-template-columns: 1.1fr 1.3fr 1fr;
    align-items: center;
    gap: 24px;
    border-bottom: 1px solid var(--line);
  }

  .brand-block {
    background: var(--yellow);
    color: #000;
    display: flex;
    flex-direction: column;
    line-height: 1;
    padding: 34px 70px 34px 40px;
    clip-path: polygon(0 0, 92% 0, 100% 100%, 0 100%);
  }

  .b-main {
    font-family: var(--font-display);
    font-size: 2.8rem;
  }

  .b-sub {
    font-family: var(--font-label);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 2px;
  }

  .motto {
    font-family: var(--font-label);
    text-transform: uppercase;
    letter-spacing: 6px;
    color: var(--yellow);
    text-align: center;
    font-size: 1rem;
  }

  .motto i {
    font-style: normal;
    margin: 0 12px;
  }

  .newsletter {
    padding-right: 28px;
  }

  .newsletter label {
    display: block;
    font-size: 0.85rem;
    margin-bottom: 6px;
  }

  .field {
    display: flex;
    border: 1px solid var(--yellow);
  }

  .field input {
    flex: 1;
    background: transparent;
    border: none;
    color: #fff;
    padding: 12px 14px;
    font-family: var(--font-body);
    outline: none;
    min-width: 0;
  }

  .field button {
    background: var(--yellow);
    border: none;
    width: 48px;
    font-size: 1.2rem;
    cursor: pointer;
  }

  .bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 18px;
    padding-bottom: 18px;
    font-size: 0.85rem;
    gap: 16px;
    flex-wrap: wrap;
  }

  .socials {
    display: flex;
    gap: 18px;
    color: var(--yellow);
  }

  @media (max-width: 900px) {
    .footer-band {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-bottom: 32px;
    }

    .brand-block {
      clip-path: none;
      padding: 28px;
    }

    .newsletter {
      padding: 0 28px;
    }
  }
</style>